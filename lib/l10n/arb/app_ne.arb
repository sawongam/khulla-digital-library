  "guideGettingStartedTitle": "सुरु गर्दै",
  "guideGettingStartedSummary": "पहिलो दिन के गर्ने, अनुप्रयोगले कुन कुरालाई के भन्छ, र डेस्कको सामान्य दिन कस्तो हुन्छ।",
  "guideGettingStartedSetupHeading": "पहिलो घण्टा",
  "guideGettingStartedSetupBody": "नयाँ इन्स्टलेसनमा तपाईंले बनाएको खाताबाहेक केही हुँदैन। यी आठ चरणले पछाडि चल्ने पुस्तकालय खडा गर्छन्। क्रमैसँग गर्नुहोस्: सापटी नियम बन्नुअघि दिइएको सापटीसँग म्याद गणना गर्ने आधार नै हुँदैन।",
  "guideGettingStartedOrderTitle": "छिटोभन्दा क्रम महत्त्वपूर्ण छ",
  "guideGettingStartedOrderBody": "रेकर्डअघि नियम, सापटीअघि रेकर्ड। सापटी अवधि तोक्नुअघि किताब दिनुभयो भने म्याद जे पूर्वनिर्धारित थियो त्यही हुन्छ, र पछिका सबै सुधार हातैले गर्नुपर्छ।",
  "guideGettingStartedModelHeading": "खुल्लाले पुस्तकालयलाई कसरी बुझ्छ",
  "guideGettingStartedModelBody": "छ वटा शब्दले अनुप्रयोगको अधिकांश भाग समेट्छन्। यी बुझेपछि बाँकी स्क्रिनहरू आफैँ बुझिन्छन्।",
  "guideGettingStartedBackupTitle": "यही कम्प्युटरमा एउटै मात्र प्रति छ",
  "guideGettingStartedBackupBody": "खुल्लाले क्याटलगलाई यही मेसिनको फाइलमा राख्छ। केही पनि कतै अपलोड हुँदैन - यसैले यो इन्टरनेटविना चल्छ, र यसैले ब्याकअप सर्भरको होइन तपाईंकै जिम्मेवारी हो।",
  "guideGettingStartedDayHeading": "सामान्य दिन",
  "guideGettingStartedDayBody": "पुस्तकालय सेटअप भइसकेपछि धेरैजसो दिन यिनै चार काममा बित्छन्।",
  "guideGettingStartedDayStep1Title": "ड्यासबोर्ड खोल्नुहोस्",
  "guideGettingStartedDayStep1Body": "ध्यान चाहिने कुरा यसैमा देखिन्छ: के बाहिर छ, के ढिलो भयो, कति रकम बाँकी छ। यहाँ दुई मिनेटले दिन कस्तो हुने हो भन्ने बताउँछ।",
  "guideGettingStartedDayStep2Title": "डेस्कमा काम गर्नुहोस्",
  "guideGettingStartedDayStep2Body": "सदस्यले लैजाँदा प्रति चेक आउट गर्नुहोस्, फर्काउँदा चेक इन। फिर्तामा जरिवाना आफैँ उठ्छ, त्यसैले केही सम्झिराख्नु पर्दैन।",
  "guideGettingStartedDayStep3Title": "होल्ड सेल्फ खाली गर्नुहोस्",
  "guideGettingStartedDayStep3Body": "पर्खिरहेको सदस्यका लागि छुट्याइएका प्रति तोकिएको दिनसम्म होल्ड सेल्फमा बस्छन्। दिनको एक पटक लाइन हेर्नुहोस्, नत्र आरक्षित किताब हप्तौँ डेस्कपछाडि थन्किन्छ।",
  "guideGettingStartedDayStep4Title": "बन्द गर्नुअघि ब्याकअप लिनुहोस्",
  "guideGettingStartedDayStep4Body": "क्याटलग फाइलमा निर्यात गरी पेन ड्राइभ वा अर्को मेसिनमा सार्नुहोस्। केही सेकेन्ड लाग्छ, र यही नै नराम्रो दिन र गुमेको पुस्तकालयबीचको भेद हो।",
  "guideGettingStartedFaq1Q": "मलाई इन्टरनेट चाहिन्छ?",
  "guideGettingStartedFaq1A": "पर्दैन। यो गाइडसहित खुल्ला पूरै यही कम्प्युटरमा चल्छ। तपाईंले आफैँ निर्यात नगरेसम्म कुनै पनि विवरण मेसिनबाट बाहिर जाँदैन।",
  "guideGettingStartedFaq2Q": "दुई कम्प्युटरले एउटै क्याटलग बाँड्न सक्छन्?",
  "guideGettingStartedFaq2A": "अहिलेसम्म सक्दैनन्। हरेक इन्स्टलेसनको आफ्नै क्याटलग फाइल हुन्छ। दुई डेस्कमा काम गर्नुहुन्छ भने एउटालाई मुख्य मान्नुहोस् र दुई पटक प्रविष्टि गर्नुको साटो निर्यात प्रयोग गर्नुहोस्।",
  "guideGettingStartedFaq3Q": "चेक आउट गर्दागर्दै बिजुली गयो भने?",
  "guideGettingStartedFaq3A": "चेक आउट एकै पटकमा लेखिन्छ, त्यसैले या भयो या भएन - आधा सापटी कहिल्यै भेटिँदैन। शंका लागे अनुप्रयोग फेरि खोली सदस्यको रेकर्ड हेर्नुहोस्।",
  "@guideGettingStartedFaq3A": {
    "description": "गाइड - सुरु गर्ने लेख"
  },

  "guideTermLocalFirst": "स्थानीय-पहिलो",
  "guideTermLocalFirstMeaning": "सबै कुरा यही कम्प्युटरको फाइलमा रहन्छ। खाता छैन, सर्भर छैन, मासिक शुल्क छैन - र स्वतः ब्याकअप पनि छैन।",
  "guideTermTitle": "शीर्षक",
  "guideTermTitleMeaning": "कृति, वस्तु होइन: तपाईंसँग जति प्रति भए पनि शीर्षक एउटै हो।",
  "guideTermCopy": "प्रति",
  "guideTermCopyMeaning": "सेल्फमा रहेको एउटा भौतिक वस्तु, आफ्नै बारकोडसहित। एउटै शीर्षकका तीन प्रति भए तीन जनाले एकैचोटि लैजान सक्छन्।",
  "guideTermMember": "सदस्य",
  "guideTermMemberMeaning": "सापटी लिन पाउने व्यक्ति - विद्यार्थी, शिक्षक वा सर्वसाधारण। उनीहरूसँग कार्ड नम्बर हुन्छ।",
  "guideTermLoan": "सापटी",
  "guideTermLoanMeaning": "एउटा प्रति, एक सदस्यको हातमा, म्यादसहित। चेक आउटमा खुल्छ, फिर्तामा बन्द हुन्छ।",
  "guideTermHold": "होल्ड",
  "guideTermHoldMeaning": "सबै प्रति बाहिर गएको शीर्षकका लागि सदस्यको पालो। यसलाई आरक्षण पनि भनिन्छ।",
  "guideTermIsbn": "ISBN",
  "guideTermIsbnMeaning": "प्रकाशकले दिएको संस्करणको विश्वव्यापी नम्बर। यो प्रतिको होइन शीर्षकको हो, र दोहोरो रेकर्ड बन्नुअघि पत्ता लगाउने सबैभन्दा छिटो उपाय हो।",
  "guideTermCallNumber": "कल नम्बर",
  "guideTermCallNumberMeaning": "प्रति तपाईंको सेल्फमा कहाँ बस्छ भन्ने। ड्युई होस्, विषय उपसर्ग होस् वा सामान्य सेल्फ कोड - एकरूप भए पुग्छ।",
  "guideTermBarcode": "बारकोड",
  "guideTermBarcodeMeaning": "स्क्यानरलाई एउटा प्रति चिनाउने नम्बर। दुई प्रतिको बारकोड कहिल्यै एउटै हुनु हुँदैन।",
  "guideTermFormat": "ढाँचा",
  "guideTermFormatMeaning": "यो कस्तो वस्तु हो: किताब, पत्रिका, अडियो, नक्सा। रिपोर्टले सङ्ग्रहलाई यसै अनुसार समूहमा बाँड्छ।",
  "guideTermHoldShelf": "होल्ड सेल्फ",
  "guideTermHoldShelfMeaning": "आरक्षण गर्ने सदस्यका लागि फर्किएको प्रति पर्खिने ठाउँ। तोकिएको दिनपछि यो फेरि प्रचलनमा जान्छ।",
  "guideTermRenewal": "नवीकरण",
  "guideTermRenewalMeaning": "खुला सापटीको अवधि थप्नु। कति पटक थप्न पाइन्छ भन्ने नियमले तोक्छ, र कसैले पर्खिरहेको शीर्षक नवीकरणबाट रोकिन सक्छ।",
  "guideTermOverdue": "ढिलो",
  "guideTermOverdueMeaning": "म्याद नाघेको तर नफर्किएको। छुट दिनपछि ढिलो भएको दिनदेखि जरिवाना गणना हुन्छ।",
  "guideTermMemberType": "सदस्यता श्रेणी",
  "guideTermMemberTypeMeaning": "उही सीमा बाँड्ने सदस्यहरूको समूह: कति प्रति, कति समयका लागि, र सदस्यता कति महिना चल्ने।",
  "guideTermCardNumber": "कार्ड नम्बर",
  "guideTermCardNumberMeaning": "सदस्यको कार्डमा लेखिएको नम्बर। नाम टाइप गर्नुको साटो यसैले डेस्कले एकै पटकमा सदस्य भेट्टाउँछ।",
  "guideTermStanding": "अवस्था",
  "guideTermStandingMeaning": "सदस्यले अहिले सापटी लिन पाउँछन् कि पाउँदैनन्। म्याद सकिएको सदस्यता, नफर्काएका ढिला प्रति वा नतिरिएको जरिवानाले रोक्न सक्छ।",
  "@guideTermStanding": {
    "description": "गाइड - धेरै लेखमा दोहोरिने साझा शब्दावली"
  },

  "guideDashboardTitle": "ड्यासबोर्ड",
  "guideDashboardSummary": "खुल्ने स्क्रिनले के भनिरहेको छ, र त्यहाँका हरेक अङ्कबारे के गर्ने।",
  "guideDashboardReadingHeading": "अङ्कहरू पढ्दै",
  "guideDashboardReadingBody": "ड्यासबोर्डले एउटै प्रश्नको उत्तर दिन्छ: आज केही बिग्रेको छ? माथिका टाइलहरू यही क्षणका गणना हुन्, तलको सूची हालैका डेस्क गतिविधि, र पुछारका बटन तपाईंले सबैभन्दा धेरै गर्ने दुई काम।",
  "guideDashboardShotCaption": "ड्यासबोर्ड, माथिदेखि तलसम्म",
  "guideDashboardShotMarker1": "आजका गणना। शून्य हुनुपर्ने ठाउँमा शून्य नभएको अङ्क नै पहिले हेर्नुपर्ने कुरा हो।",
  "guideDashboardShotMarker2": "हालैका गतिविधि - पछिल्ला चेक आउट र फिर्ता, नयाँ पहिले। गलत स्क्यान एक मिनेटभित्रै पत्ता लगाउन काम लाग्छ।",
  "guideDashboardShotMarker3": "डेस्कका दुई काम एकै क्लिकमा, ताकि काउन्टरको लाइन नेभिगेसनमा नअड्कियोस्।",
  "guideDashboardActingHeading": "देखेपछि के गर्ने",
  "guideDashboardActingStep1Title": "ढिलो शून्य छैन",
  "guideDashboardActingStep1Body": "सापटी सूची खोली म्याद अनुसार क्रमबद्ध गर्नुहोस्। सबैभन्दा पुराना ढिला प्रति आफैँ फर्कने सम्भावना कम हुन्छ, त्यसैले पहिले तिनकै पछि लाग्नुहोस्।",
  "guideDashboardActingStep2Title": "काउन्टरमा लाइन छ",
  "guideDashboardActingStep2Body": "सिधै चेक आउटमा जानुहोस्। कार्ड नम्बरबाट सदस्य खोज्नुहोस्, हरेक प्रति स्क्यान गर्नुहोस्, एक पटक पुष्टि गर्नुहोस्। अरू केही खोल्नु पर्दैन।",
  "guideDashboardActingStep3Title": "महिना कस्तो रह्यो भनेर कसैले सोध्छ",
  "guideDashboardActingStep3Body": "ड्यासबोर्ड आजको हो। अवधिको लागि रिपोर्ट खोल्नुहोस् - त्यहीँ महिना छानेर निर्यात गर्नुहोस्, टाइल गन्नुहोस् नभई।",
  "guideDashboardFiguresTitle": "टाइलहरू सुरक्षित गरिएका होइनन्, तत्कालै गणना हुन्छन्",
  "guideDashboardFiguresBody": "स्क्रिन खुल्दा हरेक गणना क्याटलगबाटै फेरि निकालिन्छ। पुरानो हुने क्यास गरिएको अङ्क छैन, र यहाँको कुनै अङ्कलाई रिपोर्टले काट्दैन।",
  "@guideDashboardFiguresBody": {
    "description": "गाइड - ड्यासबोर्ड लेख"
  },

  "guideCatalogTitle": "क्याटलग",
  "guideCatalogSummary": "शीर्षक, प्रति, लेबल र बारकोड - सङ्ग्रह कसरी रेकर्ड हुन्छ, र एउटै किताब दुई रेकर्ड किन हुन्छ।",
  "guideCatalogModelHeading": "शीर्षक र प्रति",
  "guideCatalogModelBody": "यही एउटा कुराले मानिसलाई अलमल्याउँछ, र बाँकी सबै यसैबाट निस्कन्छ। शीर्षक कृति हो। प्रति वस्तु हो। कृति एक पटक क्याटलग गर्नुहोस् र सेल्फका हरेक वस्तुका लागि प्रति थप्नुहोस्।",
  "guideCatalogOneTitleTitle": "एउटा शीर्षक, धेरै प्रति",
  "guideCatalogOneTitleBody": "एउटै किताबका चार प्रति छन् भने शीर्षक एक पटक बनाएर चार प्रति थप्नुहोस्। चार पटक बनाउनुभयो भने लेखकको नाम बिग्रँदा चार रेकर्ड सच्याउनुपर्छ, र रिपोर्टले तपाईंसँग चार फरक किताब छन् भन्छ।",
  "guideCatalogAddHeading": "सङ्ग्रहमा थप्दै",
  "guideCatalogShotCaption": "शीर्षक सूची",
  "guideCatalogShotMarker1": "टाइप गर्दै जाँदा खोजले शीर्षक, लेखक र ISBN खोज्छ, र बटनले नभएको कृतिको फारम खोल्छ।",
  "guideCatalogShotMarker2": "हरेक कृतिको एक हरफ। उपलब्धता स्तम्भले अहिले सेल्फमा कति प्रति छन् भन्छ, तपाईंसँग जम्मा कति छन् भन्दैन।",
  "guideCatalogAddStep1Title": "थप्नुअघि खोज्नुहोस्",
  "guideCatalogAddStep1Body": "ISBN वा शीर्षकका सुरुका शब्द टाइप गर्नुहोस्। पहिल्यै क्याटलग भइसकेको छ भने दोस्रो रेकर्ड बनाउनुको साटो त्यसैमा प्रति थप्नुहोस्।",
  "guideCatalogAddStep2Title": "कृति रेकर्ड गर्नुहोस्",
  "guideCatalogAddStep2Body": "लेखक, ISBN, प्रकाशक, वर्ष, विषय र ढाँचा। भएको जति भर्नुहोस् - अनुप्रयोगले शीर्षक मात्र अनिवार्य माग्छ - तर एक वर्षपछि सङ्ग्रह खोज्न मिल्ने बनाउने ISBN र विषय नै हुन्।",
  "guideCatalogAddStep3Title": "हरेक वस्तुका लागि प्रति थप्नुहोस्",
  "guideCatalogAddStep3Body": "हरेक प्रतिको आफ्नै बारकोड र कल नम्बर हुन्छ। बारकोड खाली छोड्नुभयो भने खुल्लाले पुस्तकालय प्रोफाइलको ढाँचाबाट अर्को नम्बर बनाइदिन्छ।",
  "guideCatalogAddStep4Title": "प्रतिमा लेबल टाँस्नुहोस्",
  "guideCatalogAddStep4Body": "डेस्कमा स्क्यानरले पढ्न सकोस् भनेर स्पाइन लेबल र बारकोड स्टिकर छाप्नुहोस्। बारकोडविनाको प्रति हरेक पटक हातैले टाइप गर्नुपर्छ।",
  "guideCatalogLabelsHeading": "लेबल र बारकोड",
  "guideCatalogLabelsBody": "लेबल डेस्कले तपाईंले छानेका प्रतिका स्पाइन लेबल र बारकोड स्टिकर एउटै पानामा मिलाएर छाप्छ। नयाँ प्रतिको पूरै समूह एकै पटक छाप्नुहोस्, र काउन्टरमा स्क्यानर राख्नुहोस् - यसले तीस सेकेन्डको चेक आउटलाई पाँच सेकेन्डमा झार्छ।",
  "guideCatalogLabelsWarnTitle": "पचास छाप्नुअघि पहिलो पाना जाँच्नुहोस्",
  "guideCatalogLabelsWarnBody": "प्रिन्टरले पाना फरक-फरक आकारमा छाप्छन्। एउटा पाना छापेर स्टिकर किताबमा राखी हेर्नुहोस्, र स्क्यानरले पढेपछि मात्र पूरै पाना छाप्नुहोस्।",
  "guideCatalogFaqHeading": "बारम्बार सोधिने प्रश्न",
  "guideCatalogFaq1Q": "एउटै किताब दुई पटक थपेछु। अब के गर्ने?",
  "guideCatalogFaq1A": "राख्न चाहेको रेकर्डमा प्रतिहरू सार्नुहोस्, अनि खाली भएको दोहोरो शीर्षक मेट्नुहोस्। प्रति बाँकी रहेको शीर्षक मेट्न दिइँदैन - यो अनुप्रयोगले सापटीको इतिहास जोगाएको हो।",
  "guideCatalogFaq2Q": "प्रति हरायो वा बिग्रियो। मेट्ने हो?",
  "guideCatalogFaq2A": "होइन। बरु त्यसको स्थिति परिवर्तन गर्नुहोस्। प्रति मेट्नुले त्यो कहिल्यै सापटीमा गएको थियो भन्ने तथ्य पनि मेटाउँछ, र अर्को वर्षको लगतले त्यो खाडल व्याख्या गर्न सक्दैन।",
  "guideCatalogFaq3Q": "कल नम्बरमा के लेख्ने?",
  "guideCatalogFaq3A": "तपाईं जे अनुसार सेल्फमा राख्नुहुन्छ, त्यही। सानो पुस्तकालयले विषय कोड र क्रमसङ्ख्या प्रयोग गर्न सक्छ। कुन प्रणाली रोज्ने भन्दा एकरूपता धेरै महत्त्वपूर्ण छ।",
  "guideCatalogFaq4Q": "ISBN अनिवार्य हो?",
  "guideCatalogFaq4A": "होइन, र पुराना तथा स्थानीय रूपमा प्रकाशित सामग्रीमा प्रायः हुँदैन। बनाएर लेख्नुभन्दा खाली छोड्नुहोस्।",
  "@guideCatalogFaq4A": {
    "description": "गाइड - क्याटलग लेख"
  },

  "guideCirculationTitle": "प्रचलन",
  "guideCirculationSummary": "चेक आउट, फिर्ता, होल्ड र जरिवाना - डेस्कले दिनभर गर्ने चार काम।",
  "guideCirculationCheckOutHeading": "चेक आउट गर्दै",
  "guideCirculationCheckOutBody": "चेक आउटले एक सदस्यसँग एक वा बढी प्रति जोडेर हरेकका लागि सापटी खोल्छ। म्याद टाइप गरिँदैन - त्यो सापटी नियम र सदस्यको श्रेणीबाट आउँछ, त्यसैले ती पहिले सेटअप गरिन्छन्।",
  "guideCirculationShotCaption": "चेक आउट डेस्क",
  "guideCirculationShotMarker1": "पहिले सदस्य, त्यसपछि प्रति। सापटी अवधि र सीमा सदस्यले तोक्ने भएकाले फारमले यही क्रममा सोध्छ।",
  "guideCirculationShotMarker2": "पुष्टि गर्नुअघि उनीहरूसँग जाने सबै वस्तुको सूची। काउन्टरमा राखिएको थाकसँग सङ्ख्या मिलाउनुहोस्।",
  "guideCirculationCheckOutStep1Title": "सदस्य खोज्नुहोस्",
  "guideCirculationCheckOutStep1Body": "कार्ड नम्बर स्क्यान वा टाइप गर्नुहोस्। नाम र फोनले पनि काम गर्छ, तर कार्ड नम्बर स्पष्ट हुन्छ र दुई सदस्यको नाम उही हुन सक्छ।",
  "guideCirculationCheckOutStep2Title": "हरेक प्रति स्क्यान गर्नुहोस्",
  "guideCirculationCheckOutStep2Body": "हरेक बारकोडले एउटा हरफ थप्छ। सारांशले म्याद, यो सदस्यले अझै कति प्रति लैजान पाउँछन्, र उनीहरूको बाँकी जरिवाना देखाउँछ।",
  "guideCirculationCheckOutStep3Title": "एक पटक पुष्टि गर्नुहोस्",
  "guideCirculationCheckOutStep3Body": "एउटै पुष्टिले सूचीका सबै सापटी लेख्छ। सदस्यले सीमा नाघे वा रोकिएका छन् भने डेस्कले यही ठाउँमा भन्छ, उनीहरू गइसकेपछि होइन।",
  "guideCirculationReturnHeading": "प्रति फिर्ता लिँदै",
  "guideCirculationReturnBody": "फिर्ता डेस्कमा प्रति स्क्यान गर्नासाथ सापटी बन्द हुन्छ। ढिलो भएको छ भने दर, छुट दिन र ढिलो भएका दिनबाट त्यसै बेला जरिवाना गणना गरी रेकर्ड हुन्छ - कसैले हिसाब गर्नु पर्दैन, र कसैले बिर्सन पनि सक्दैन।",
  "guideCirculationReturnWarnTitle": "सदस्यले तिर्न नसके पनि प्रति फिर्ता लिनुहोस्",
  "guideCirculationReturnWarnBody": "जरिवाना प्रतिविरुद्ध होइन, सदस्यविरुद्ध रेकर्ड हुन्छ। तिरेपछि मात्र फिर्ता लिने गर्नुभयो भने प्रति सेल्फबाहिरै रहन्छ र सापटी खुलै रहन्छ, जसले नमिलेसम्म हरेक गणना गलत बनाउँछ।",
  "guideCirculationHoldsHeading": "होल्ड र नवीकरण",
  "guideCirculationHoldsBody": "शीर्षकका सबै प्रति बाहिर हुँदा सदस्यले पालोमा नाम लेखाउन सक्छन्। फिर्ता आएको अर्को प्रति पहिलो पर्खिने व्यक्तिका लागि छुट्याइन्छ, र नियमले तोकेको दिनसम्म होल्ड सेल्फमा बसेर त्यसपछि अर्को सदस्यकहाँ जान्छ।",
  "guideCirculationFinesHeading": "जरिवाना",
  "guideCirculationFinesBody": "जरिवाना खातामा कति उठ्यो, कति सङ्कलन भयो र कति मिनाहा भयो भन्ने देखिन्छ। ढिलो फिर्तामा जरिवाना आफैँ उठ्छ; सङ्कलन वा मिनाहा भने नाम भएको कर्मचारीको सचेत निर्णय हो।",
  "guideCirculationFinesStep1Title": "जरिवाना खोज्नुहोस्",
  "guideCirculationFinesStep1Body": "खाताले सदस्य र मिति अनुसार सूची देखाउँछ। सदस्यको आफ्नै रेकर्डमा पनि बाँकी रकम देखिन्छ, र उनीहरू अगाडि उभिएका बेला त्यही बाटो छिटो हुन्छ।",
  "guideCirculationFinesStep2Title": "के भयो रेकर्ड गर्नुहोस्",
  "guideCirculationFinesStep2Body": "पैसा बुझेपछि तिरिएको चिन्ह लगाउनुहोस्, वा पुस्तकालयले छोड्ने निर्णय गरे मिनाहा। दुवै रकमसहित रेकर्ड हुन्छन्।",
  "guideCirculationFinesStep3Title": "रेकर्ड होइन, दर मिलाउनुहोस्",
  "guideCirculationFinesStep3Body": "सबैतिर जरिवाना धेरै आइरहेको छ भने सापटी नियमको दर नै गलत छ। त्यहीँ बदल्नुहोस् - पुराना जरिवाना एक-एक गरी सच्याउँदा वास्तविक समस्या लुक्छ।",
  "guideCirculationWaiveTitle": "मिनाहा स्थायी रेकर्ड हो",
  "guideCirculationWaiveBody": "जरिवाना मिनाहा गर्ने खाताको नाममा त्यो लेखिन्छ र हट्दैन। यही नै उद्देश्य हो: साझा डेस्क मेसिनमा उदार निर्णय र लुकाइएको निर्णय छुट्याउने अरू केही छैन।",
  "guideCirculationFaqHeading": "बारम्बार सोधिने प्रश्न",
  "guideCirculationFaq1Q": "गलत प्रति चेक आउट गरेछु। कसरी हटाउने?",
  "guideCirculationFaq1A": "तुरुन्तै फिर्ता गर्नुहोस्। एउटै मिनेटमा खुलेको र बन्द भएको सापटीमा जरिवाना लाग्दैन र इमानदार अभिलेख बाँकी रहन्छ, जुन सच्याइएको रेकर्डले दिँदैन।",
  "guideCirculationFaq2Q": "सदस्यले किताब अझै राख्न चाहन्छन्।",
  "guideCirculationFaq2A": "सापटी नवीकरण गर्नुहोस्। कति पटक नवीकरण गर्न पाइन्छ भन्ने नियमले तोक्छ, र कसैले पर्खिरहेको शीर्षकलाई पालो अघि बढोस् भनेर नवीकरणबाट रोक्न सकिन्छ।",
  "guideCirculationFaq3Q": "बारकोड स्क्यान हुँदैन।",
  "guideCirculationFaq3A": "नम्बर टाइप गर्नुहोस् - हरेक स्क्यान फिल्डले टाइप स्वीकार्छ। कुनै स्टिकर कहिल्यै स्क्यान हुँदैन भने लेबल डेस्कबाट फेरि छाप्नुहोस्।",
  "guideCirculationFaq4Q": "रोकिएका सदस्यलाई चेक आउट गर्न मिल्छ?",
  "guideCirculationFaq4A": "रोक कायम रहेसम्म मिल्दैन। रोकको कारण हटाउनुहोस् - ढिलो प्रति फिर्ता लिनुहोस्, जरिवाना उठाउनुहोस् वा मिनाहा गर्नुहोस्, सदस्यता नवीकरण गर्नुहोस् - त्यसपछि डेस्कले सापटी दिन्छ।",
  "@guideCirculationFaq4A": {
    "description": "गाइड - प्रचलन लेख"
  },

  "guideMembersTitle": "सदस्य",
  "guideMembersSummary": "सदस्य दर्ता, सीमा तोक्ने श्रेणी, र कसैलाई सापटी लिनबाट के कुराले रोक्छ।",
  "guideMembersRegisterHeading": "सदस्य दर्ता",
  "guideMembersRegisterBody": "सदस्य रेकर्ड जानाजान छोटो छ: व्यक्ति चिन्न र ढिलो किताबबारे सम्पर्क गर्न पुग्ने जति, र पुस्तकालयलाई नचाहिने केही पनि होइन।",
  "guideMembersShotCaption": "सदस्य दर्ता किताब",
  "guideMembersShotMarker1": "नाम, कार्ड नम्बर वा फोनबाट खोज्नुहोस्। बटनले दर्ता फारम खोल्छ।",
  "guideMembersShotMarker2": "चेतावनी रङमा देखिने हरफ अहिले सापटी लिन नपाउने सदस्य हो - म्याद सकिएको, रोकिएको वा जरिवाना सीमा नाघेको।",
  "guideMembersRegisterStep1Title": "पहिले नै दर्ता छैनन् भनी जाँच्नुहोस्",
  "guideMembersRegisterStep1Body": "पहिले फोन नम्बर खोज्नुहोस्। दुई पटक दर्ता भएका सदस्यको सापटी सीमा दोब्बर हुन्छ, र इतिहास दुई रेकर्डमा बाँडिन्छ।",
  "guideMembersRegisterStep2Title": "व्यक्ति रेकर्ड गर्नुहोस्",
  "guideMembersRegisterStep2Body": "नाम र सम्पर्कको माध्यम। कार्ड नम्बर खाली छोड्न सकिन्छ, खुल्लाले अर्को नम्बर जारी गर्छ।",
  "guideMembersRegisterStep3Title": "श्रेणी छान्नुहोस्",
  "guideMembersRegisterStep3Body": "यही महत्त्वपूर्ण फिल्ड हो। यसले कति प्रति, कति समयका लागि र सदस्यता कहिले सकिने भन्ने तोक्छ। श्रेणी बदल्दा सीमा पनि सँगै बदलिन्छ।",
  "guideMembersCategoriesHeading": "श्रेणी र सीमा",
  "guideMembersCategoriesBody": "व्यक्तिपिच्छे सीमा तोक्नुको साटो श्रेणीपिच्छे तोक्नुहोस्, र हरेक सदस्यलाई एउटा श्रेणीमा राख्नुहोस्। विद्यार्थीले पन्ध्र दिनका लागि तीन, शिक्षकले सत्रभरि दस - श्रेणी एक पटक सम्पादन गर्दा त्यसभित्रका सबै सँगै सर्छन्।",
  "guideMembersStandingHeading": "कसैले सापटी लिन नपाउँदा",
  "guideMembersStandingBody": "तीन कुराले सापटी रोक्छ: सदस्यता सकिएको, नियमले रोक्दा सदस्यसँग ढिलो प्रति बाँकी रहेको, वा अधिकतम बाँकी जरिवानाभन्दा बढी ऋण। सदस्यको रेकर्डले कुन कारण हो भन्छ, त्यसैले डेस्कले अनुमान नगरी जवाफ दिन सक्छ।",
  "guideMembersBlockedTitle": "रोक सजाय होइन, नियम हो",
  "guideMembersBlockedBody": "हरेक रोक सापटी नियमको कुनै सेटिङबाट आउँछ। सापटी दिन चाहेका मानिस रोकिइरहेका छन् भने सदस्यपिच्छे उपाय खोज्नुको साटो नियमै बदल्नुहोस्।",
  "guideMembersFaq1Q": "सदस्यले कार्ड हराए।",
  "guideMembersFaq1A": "उनीहरूकै रेकर्डमा नयाँ कार्ड नम्बर जारी गर्नुहोस्। रेकर्ड भने राख्नुहोस् - त्यसमा उनीहरूको सापटी इतिहास र बाँकी रकम छ।",
  "guideMembersFaq2Q": "छोडेर गएका सदस्यलाई मेट्न मिल्छ?",
  "guideMembersFaq2A": "मिल्छ, तर राख्नुपर्ने इतिहास छ भने बरु सदस्यता सकिन दिनुहोस्। मेट्ने काम गल्तीले बनेको रेकर्डका लागि हो।",
  "guideMembersFaq3Q": "दुई जनाको नाम उही छ।",
  "guideMembersFaq3A": "कार्ड नम्बर यसैका लागि हो। डेस्कमा कार्ड नम्बरबाट खोज्नुहोस्, अन्योल आउँदै आउँदैन।",
  "@guideMembersFaq3A": {
    "description": "गाइड - सदस्य लेख"
  },

  "guideReportsTitle": "रिपोर्ट",
  "guideReportsSummary": "समितिले सोध्ने प्रश्न, हरेक उत्तर कहाँ छ, र त्यसलाई फाइलमा कसरी निकाल्ने।",
  "guideReportsQuestionsHeading": "कुन रिपोर्टले के भन्छ",
  "guideReportsQuestionsBody": "माथि अवधि छान्नुहोस्, स्क्रिनका सबै अङ्क त्यसै अनुसार चल्छन्। ड्यासबोर्ड आजको हो; यो तपाईंले छानेको जुनसुकै अवधिको।",
  "guideReportsCirculationMeaning": "पुस्तकालय कति व्यस्त रह्यो - अवधिभरि दिइएका सापटी र फर्किएका प्रति। अनुदान माग्दा प्रायः यही अङ्क चाहिन्छ।",
  "guideReportsCollectionMeaning": "तपाईंसँग वास्तवमा के छ, ढाँचा अनुसार। सङ्ग्रहको नब्बे प्रतिशत एउटै कुरा रहेछ भन्ने पत्ता लगाउन काम लाग्छ।",
  "guideReportsMembersMeaning": "महिनैपिच्छे थपिएका सदस्य। अभियानपछि वृद्धि भयो कि भएन भन्ने यसैले देखाउँछ।",
  "guideReportsFinesMeaning": "उठेको, सङ्कलन भएको र मिनाहा भएको। उठेको र सङ्कलन भएकोबीचको अन्तर पुस्तकालयले नखोज्ने निर्णय गरेको रकम हो।",
  "guideReportsTopTitlesMeaning": "सबैभन्दा धेरै चल्ने, क्रमसहित। थप प्रति किन्नुअघि माथिको भाग पढ्नुहोस्, र उस्तै किताब थप्नुअघि तलको।",
  "guideReportsShotCaption": "रिपोर्टको अवधि",
  "guideReportsShotMarker1": "तपाईंले छानेको अवधिका मुख्य अङ्क, आजका होइनन्।",
  "guideReportsShotMarker2": "तिनको पछाडिको विवरण, क्रमसहित। यस स्क्रिनका हरेक तालिका जस्ताको तस्तै निर्यात हुन्छन्।",
  "guideReportsExportHeading": "अङ्क बाहिर निकाल्दै",
  "guideReportsExportStep1Title": "पहिले अवधि तोक्नुहोस्",
  "guideReportsExportStep1Body": "निर्यातले स्क्रिनमा जे छ त्यही लैजान्छ, त्यसैले फाइल पछि काटछाँट गर्नुको साटो निर्यात गर्नुअघि नै महिना वा वर्ष छान्नुहोस्।",
  "guideReportsExportStep2Title": "तालिका निर्यात गर्नुहोस्",
  "guideReportsExportStep2Body": "हरेक रिपोर्टले CSV फाइल लेख्छ, जुन जुनसुकै स्प्रेडसिटमा खुल्छ। केही पनि कतै पठाइँदैन - फाइल यही कम्प्युटरमा बस्छ।",
  "guideReportsExportStep3Title": "फाइललाई त्यसकै मितिसँग राख्नुहोस्",
  "guideReportsExportStep3Body": "वैशाखमा निर्यात गरेको फाइल असारमा खोल्दा वैशाखकै देखाउँछ, र अङ्क अनुप्रयोगसँग मिल्दैन। कसैले चालू ठानेर नबोलोस् भनेर फाइलको नाममा अवधि लेख्नुहोस्।",
  "guideReportsExportTipTitle": "निर्यात तस्बिर हो, ऐना होइन",
  "guideReportsExportTipBody": "एक पटक लेखिएपछि फाइल कहिल्यै बदलिँदैन। अङ्क बदलिँदा पुरानो सम्पादन गर्नुको साटो फेरि निर्यात गर्नुहोस्।",
  "@guideReportsExportTipBody": {
    "description": "गाइड - रिपोर्ट लेख"
  },

  "guideStaffTitle": "कर्मचारी र भूमिका",
  "guideStaffSummary": "कसले के गर्न पाउँछ, हरेकलाई आफ्नै खाता किन चाहिन्छ, र बिर्सिएको पासवर्ड कसरी फिर्ता ल्याउने।",
  "guideStaffAccountsHeading": "खाताहरू",
  "guideStaffAccountsBody": "डेस्कमा काम गर्ने हरेकलाई आफ्नै खाता चाहिन्छ। कुरा गोपनीयताको होइन - मिनाहा गरिएको जरिवाना, मेटिएको प्रति र बदलिएको नियम सबै गर्ने व्यक्तिकै नाममा रेकर्ड हुन्छन्, र साझा लगइनले तीनै वटा कसैको नाममा पनि रेकर्ड गर्दैन।",
  "guideStaffAccountsStep1Title": "खाता बनाउनुहोस्",
  "guideStaffAccountsStep1Body": "नाम, इमेल र पहिलो पासवर्ड। पहिलो पटक साइन इन गर्दा पासवर्ड बदल्न भन्नुहोस्।",
  "guideStaffAccountsStep2Title": "काम चल्ने सबैभन्दा सानो भूमिका दिनुहोस्",
  "guideStaffAccountsStep2Body": "उनीहरूले वास्तवमा गर्ने कामलाई पुग्ने भूमिकाबाट सुरु गर्नुहोस्। पछि भूमिका फराकिलो पार्न सेकेन्ड लाग्छ; मेटिएको क्याटलगको सफाइ दिन त्यति सजिलो हुँदैन।",
  "guideStaffAccountsStep3Title": "छोडेर जाँदा खाता बन्द गर्नुहोस्",
  "guideStaffAccountsStep3Body": "मेट्नुको साटो निष्क्रिय पार्नुहोस्। खाता तुरुन्तै चल्न छोड्छ, र त्यसले गरेका सबै काम नाममै रहन्छन्।",
  "guideStaffRolesHeading": "चार भूमिका",
  "guideStaffRolesBody": "भूमिका भनेको अनुमतिको समूह हो, र हरेक अनुमतिका दुई तह हुन्छन्: खण्ड देख्न पाउने, र त्यसभित्रको कुरा बदल्न पाउने। पढ्ने मात्र भूमिकाले देख्छ, बदल्दैन।",
  "guideStaffRoleAdminMeaning": "सबै कुरा, कर्मचारी खाता, सेटिङ र ब्याकअपसहित। प्रशासकको सङ्ख्या थोरै राख्नुहोस् - एक वा दुई।",
  "guideStaffRoleLibrarianMeaning": "पूरै पुस्तकालय: क्याटलग, प्रचलन, सदस्य, जरिवाना र रिपोर्ट। कर्मचारी खाता र जोखिमपूर्ण सेटिङ भने होइन।",
  "guideStaffRoleAssistantMeaning": "डेस्क। चेक आउट, फिर्ता र खोजी। क्याटलग नबदल्ने स्वयंसेवक वा आंशिक समय सहयोगीका लागि उपयुक्त।",
  "guideStaffRoleReadOnlyMeaning": "हेर्छ, केही बदल्दैन। अध्ययन कक्षको टर्मिनल वा सङ्ग्रह लेखाजोखा गर्ने व्यक्तिका लागि।",
  "guideStaffSharedTitle": "एउटै लगइन नबाँड्नुहोस्",
  "guideStaffSharedBody": "एउटा साझा खाताले अनुप्रयोगका सबै रेकर्डलाई नामविहीन बनाउँछ। प्रति हराउँदा वा जरिवाना मिनाहा हुँदा अनुप्रयोगले दिन सक्ने इमानदार जवाफ उसलाई बताइएको नाम मात्र हो - र साझा लगइनमा केही बताइएकै हुँदैन।",
  "guideStaffPasswordsHeading": "पासवर्ड र पुनःप्राप्ति",
  "guideStaffPasswordsBody": "प्रशासकले कर्मचारी सूचीबाट अरू जुनसुकै खाताको पासवर्ड रिसेट गर्न सक्छन्। पहिलो प्रशासक अपवाद हो: उनीभन्दा माथि कोही नहुने भएकाले सेटअपले एक पटक प्रयोग हुने रिकभरी कोड दिन्छ। त्यो छापेर यो कम्प्युटरभन्दा अन्तै राख्नुहोस्।",
  "guideStaffFaq1Q": "प्रशासकको पासवर्ड र रिकभरी कोड दुवै हरायो।",
  "guideStaffFaq1A": "जानाजान कुनै पछाडिको बाटो छैन - भए फाइल भेट्टाउने जोकोहीले पुस्तकालयका रेकर्ड पढ्न पाउँथे। अर्को प्रशासक खाताले पासवर्ड रिसेट गर्न सक्छ; त्यो पनि छैन भने क्याटलग फाइल नयाँ इन्स्टलेसनमा पुनःस्थापना गरेर मात्र खोल्न सकिन्छ।",
  "guideStaffFaq2Q": "भूमिकाले के गर्न पाउने भन्ने बदल्न मिल्छ?",
  "guideStaffFaq2A": "चार भूमिका स्थिर छन्, ताकि भूमिकाको अर्थ हरेक खुल्ला पुस्तकालयमा उही रहोस्। बरु व्यक्तिलाई अर्को भूमिकामा सार्नुहोस्।",
  "guideStaffFaq3Q": "साझा मेसिनमा कसैले साइन आउट गर्न बिर्सिए।",
  "guideStaffFaq3A": "डेस्क हस्तान्तरण गर्नुअघि रेलको पुछारको खाता मेनुबाट साइन आउट गर्नुहोस्। यसमा केही गुम्दैन - क्याटलग जस्ताको तस्तै रहन्छ र अर्को व्यक्ति सिधै साइन इन गर्छन्।",
  "@guideStaffFaq3A": {
    "description": "गाइड - कर्मचारी र भूमिका लेख"
  },

  "guideSettingsTitle": "सेटिङ र ब्याकअप",
  "guideSettingsSummary": "पुस्तकालयको आफ्नै विवरण, हरेक सापटीले पछ्याउने नियम, र ती सबै जोगाउने निर्यात।",
  "guideSettingsProfileHeading": "पुस्तकालय प्रोफाइल",
  "guideSettingsProfileBody": "नाम, सम्पर्क विवरण र मुद्रा। यी सजावट होइनन्: सम्पर्क हरफ ढिलो सूचनामा छापिन्छ ताकि सदस्यले कसलाई फोन गर्ने थाहा पाऊन्, र अनुप्रयोगका हरेक जरिवाना र शुल्क त्यही मुद्रामा देखिन्छन्।",
  "guideSettingsShotCaption": "सेटिङका खण्ड",
  "guideSettingsShotMarker1": "चार समूह। प्रोफाइल र नियम पुस्तकालयको रेकर्ड हुन्; रूपरङ यही यन्त्रको मात्र।",
  "guideSettingsShotMarker2": "हरेक समूह आफ्नै सेभ भएको फारम हो। सेभ नगरेसम्म केही लेखिँदैन।",
  "guideSettingsRulesHeading": "सापटी नियम",
  "guideSettingsRulesBody": "यो स्क्रिनले भविष्यका हरेक सापटीले के गर्ने भन्ने तोक्छ। हरेक फिल्डको डेस्कमा सीधा असर पर्छ।",
  "guideSettingsRuleLoanPeriod": "प्रति कति दिनका लागि बाहिर जान्छ। सदस्यको श्रेणीले यसलाई बदल्न सक्छ।",
  "guideSettingsRuleRenewals": "प्रति फर्काउनैपर्नुअघि एउटै सापटी कति पटक थप्न पाइन्छ।",
  "guideSettingsRuleBorrowLimit": "एक सदस्यले एकैपटक कति प्रति राख्न पाउँछन्। सीमा नाघ्ने प्रति चेक आउट डेस्कले अस्वीकार गर्छ।",
  "guideSettingsRuleFinePerDay": "एक दिन ढिलो हुँदा कति लाग्छ। छुट दिनपछि ढिलो भएका दिनले गुणन हुन्छ।",
  "guideSettingsRuleGraceDays": "जरिवाना नलाग्ने ढिलाइका दिन। पुस्तकालय कडा नभएसम्म दुई-तीन दिन राख्नुहोस् - यसले धेरै साना विवाद जोगाउँछ।",
  "guideSettingsRuleMaxOutstanding": "डेस्कले सापटी दिन छोड्नुअघि सदस्यले कति रकम बाँकी राख्न पाउँछन्।",
  "guideSettingsRulesForwardTitle": "नियम नयाँ सापटीमा लाग्छ, पुरानामा होइन",
  "guideSettingsRulesForwardBody": "सापटी अवधि बदल्दा पहिले नै बाहिर गएको किताबको म्याद सर्दैन। सापटीले जुन सर्तमा दिइएको थियो त्यही राख्छ, र यसैले म्याद भरपर्दो हुन्छ।",
  "guideSettingsAppearanceHeading": "रूपरङ र भाषा",
  "guideSettingsAppearanceBody": "थिम, रङ र भाषा यही यन्त्रको रोजाइ हो, क्याटलगमा होइन यही कम्प्युटरमा सुरक्षित हुन्छ। स्वतन्त्र रूपमा बदल्नुहोस्: साझा मेसिनमा हरेक इन्स्टलेसनको आफ्नै रहन्छ, र यहाँको केही पनि पुस्तकालयको रेकर्डसम्म पुग्दैन।",
  "guideSettingsBackupHeading": "ब्याकअप र पुनःस्थापना",
  "guideSettingsBackupBody": "यो अनुप्रयोगकै सबैभन्दा महत्त्वपूर्ण स्क्रिन हो। क्याटलग यही कम्प्युटरको फाइल हो, र कम्प्युटर चोरिन, खस्न वा बिग्रिन सक्छ। निर्यात भनेको एउटै फाइलमा पूरै पुस्तकालयको प्रति हो।",
  "guideSettingsBackupStep1Title": "क्याटलग निर्यात गर्नुहोस्",
  "guideSettingsBackupStep1Body": "एउटै फाइलमा हरेक शीर्षक, प्रति, सदस्य, सापटी र जरिवाना रहन्छ। ठूलो पुस्तकालयका लागि पनि केही सेकेन्ड लाग्छ।",
  "guideSettingsBackupStep2Title": "त्यसलाई अन्तै राख्नुहोस्",
  "guideSettingsBackupStep2Body": "पेन ड्राइभ, अर्को कम्प्युटर वा क्लाउड ड्राइभ। क्याटलगकै मेसिनमा बसेको ब्याकअपले केहीबाट पनि जोगाउँदैन।",
  "guideSettingsBackupStep3Title": "पालना गर्न सक्ने तालिका बनाउनुहोस्",
  "guideSettingsBackupStep3Body": "हरेक दिन बन्द गर्दा उत्तम। हरेक शुक्रबार व्यावहारिक। जे रोजे पनि नराम्रोमा अन्तिम ब्याकअपपछिको काम गुम्छ, त्यसैले गुमाउन सकिने अन्तराल रोज्नुहोस्।",
  "guideSettingsRestoreTitle": "पुनःस्थापनाले सबै कुरा बदल्छ",
  "guideSettingsRestoreBody": "पुनःस्थापना मिलान होइन। यसले यो कम्प्युटरको क्याटलगमाथि फाइलको सामग्री लेख्छ, र त्यो फाइल बनेपछि प्रविष्ट गरिएको सबै हराउँछ। जतिसुकै काम नलाग्ने लागे पनि पहिले हालको क्याटलग निर्यात गर्नुहोस्।",
  "guideSettingsFaq1Q": "मेरो क्याटलग फाइल कहाँ छ?",
  "guideSettingsFaq1A": "यो कम्प्युटरको एप्लिकेसन डाटा फोल्डरमा, डकुमेन्ट्समा होइन। जीवित फाइल खोज्नुको साटो निर्यात गरेको ब्याकअप सार्नुहोस् - अनुप्रयोगले त्यो फाइल खोलिरहेको हुन सक्छ।",
  "guideSettingsFaq2Q": "पुस्तकालय नयाँ कम्प्युटरमा सार्न मिल्छ?",
  "guideSettingsFaq2A": "मिल्छ। त्यहाँ खुल्ला इन्स्टल गर्नुहोस्, पुरानो मेसिनबाट निर्यात गर्नुहोस्, र नयाँमा पुनःस्थापना गर्नुहोस्। पुरानो मेसिन बन्द गर्नुअघि केही रेकर्ड जाँचिहेर्नुहोस्।",
  "guideSettingsFaq3Q": "फाइल कति ठूलो हुन्छ?",
  "guideSettingsFaq3A": "सानो। दसौँ हजार रेकर्ड भएको पुस्तकालय पनि इमेल गर्न मिल्ने फाइल हुन्छ, किनभने यसमा तस्बिर होइन पाठ हुन्छ।",
  "@guideSettingsFaq3A": {
    "description": "गाइड - सेटिङ र ब्याकअप लेख"
  }
}
