{
  "editor.formatOnSave": true,
  "editor.rulers": [
    80
  ],
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "dart.lineLength": 80,
  "dart.flutterSdkPath": ".fvm/versions/3.47.0",
  "dart.env": {
    "CHROME_EXECUTABLE": "/usr/bin/microsoft-edge-stable"
  },
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.fvm": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/*.config.dart": true,
    "lib/l10n/gen/**": true
  }
}