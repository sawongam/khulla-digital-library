# ── Dart & Flutter ──────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds
app.*.symbols
app.*.map.json

# FVM - commit .fvmrc; the SDK symlink and cache stay local.
.fvm/

# ── Generated code ──────────────────────────────────────────────────────────
# Regenerate with `make build` (build_runner) and `make localize` (l10n).
# Kept out of version control so a stale generated file can never disagree
# with the source it was generated from in a review.
*.freezed.dart
*.g.dart
*.config.dart
*.mocks.dart
lib/gen/
lib/l10n/gen/

# ── Melos ───────────────────────────────────────────────────────────────────
# Regenerated by `melos bootstrap`. The path dependency in pubspec.yaml is the
# committed source of truth, so a plain `flutter pub get` also resolves.
pubspec_overrides.yaml
packages/**/pubspec.lock

# ── Environment ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

